/* pages/record/record.wxss */
.page {
  padding-bottom: 60rpx;
}

/* 档案信息栏 */
.record-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #1f6feb;
  color: #fff;
  padding: 28rpx 32rpx;
}
.record-no {
  font-size: 34rpx;
  font-weight: 700;
}
.record-plate {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}
.record-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}
.record-status.active {
  background: rgba(255, 255, 255, 0.25);
}
.record-status.submitted {
  background: #2fb344;
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin: 32rpx 28rpx 16rpx;
}
.section-tip {
  font-size: 24rpx;
  font-weight: 400;
  color: #999;
  margin-left: 16rpx;
}

/* 固定步骤 */
.steps {
  margin: 0 24rpx;
}
.step {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.step.locked {
  opacity: 0.45;
}
.step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eef2f7;
  color: #1f6feb;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.step.done .step-num {
  background: #2fb344;
  color: #fff;
}
.step-info {
  flex: 1;
  margin-left: 20rpx;
}
.step-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.step-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.step-count {
  font-size: 24rpx;
  color: #2fb344;
  margin-top: 4rpx;
}
.step-btn {
  padding: 14rpx 30rpx;
  border-radius: 30rpx;
  background: #1f6feb;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.step-btn.disabled {
  background: #c9ced6;
  color: #fff;
}

/* 开关门按钮 */
.door-row {
  display: flex;
  margin: 0 24rpx;
}
.door-btn {
  flex: 1;
  background: #fff;
  border: 2rpx solid #ff8f3c;
  border-radius: 18rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  margin: 0 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.door-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff8f3c;
}
.door-count {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 统计 */
.stats {
  display: flex;
  background: #fff;
  border-radius: 18rpx;
  margin: 28rpx 24rpx;
  padding: 24rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 提交区 */
.submit-area {
  margin: 20rpx 24rpx;
}
.submit-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 预览弹层 */
.preview-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.preview-box {
  width: 620rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
}
.preview-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
}
.preview-img {
  width: 100%;
  height: 560rpx;
  background: #f0f1f4;
  border-radius: 12rpx;
}
.preview-remark {
  width: 100%;
  height: 100rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  margin-top: 20rpx;
  box-sizing: border-box;
}
.preview-actions {
  display: flex;
  margin-top: 24rpx;
}
.preview-retake {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: 2rpx solid #1f6feb;
  color: #1f6feb;
  border-radius: 12rpx;
  font-size: 30rpx;
  margin-right: 16rpx;
}
.preview-upload {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #1f6feb;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
}
.preview-close {
  text-align: center;
  color: #888;
  font-size: 28rpx;
  padding-top: 20rpx;
}
