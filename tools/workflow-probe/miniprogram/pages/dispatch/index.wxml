<view class="page">
  <view class="heading">运输管理</view>
  <view class="hint">新增运输、查询记录、选择本趟发给司机。照片详细管理请使用电脑后台。</view>
  <button open-type="share" data-kind="admin">分享固定管理入口</button>
  <view wx:if="{{error}}" class="alert">{{error}}</view>
  <view wx:if="{{!loggedIn}}" class="card">
    <input placeholder="管理员账号" value="{{username}}" data-field="username" bindinput="field" />
    <input placeholder="管理员密码" password value="{{password}}" data-field="password" bindinput="field" />
    <button class="primary" bindtap="login" disabled="{{busy}}">管理员登录</button>
  </view>
  <block wx:else>
    <button class="primary" bindtap="toggleCreate" disabled="{{busy}}">{{showCreate ? '收起新增运输' : '＋ 新增运输'}}</button>
    <view wx:if="{{showCreate}}" class="card">
      <input placeholder="车牌（必填）" value="{{plate_number}}" data-field="plate_number" bindinput="field" disabled="{{createLocked || busy}}" />
      <input placeholder="发货日期 YYYY-MM-DD" value="{{ship_date}}" data-field="ship_date" bindinput="field" disabled="{{createLocked || busy}}" />
      <input placeholder="装货地 / 目的地说明（必填）" maxlength="120" value="{{description}}" data-field="description" bindinput="field" disabled="{{createLocked || busy}}" />
      <input placeholder="批次（选填）" maxlength="60" value="{{batch}}" data-field="batch" bindinput="field" disabled="{{createLocked || busy}}" />
      <view wx:if="{{createLocked}}" class="hint">上次创建结果待确认，重试会沿用同一请求，避免重复建档。</view>
      <button class="primary" bindtap="create" disabled="{{busy}}">{{createLocked ? '重试并确认创建结果' : '创建本趟运输'}}</button>
    </view>
    <view class="actions">
      <button data-field="phase" data-value="" bindtap="filter" disabled="{{busy}}">全部运输</button>
      <button data-field="phase" data-value="awaiting_plate" bindtap="filter" disabled="{{busy}}">待发给司机</button>
    </view>
    <view class="actions">
      <button data-field="sort" data-value="created_desc" bindtap="filter" disabled="{{busy}}">{{sort === 'created_desc' ? '✓ ' : ''}}创建最新</button>
      <button data-field="sort" data-value="updated_desc" bindtap="filter" disabled="{{busy}}">{{sort === 'updated_desc' ? '✓ ' : ''}}更新最新</button>
    </view>
    <input placeholder="搜索车牌或运输编号" value="{{keyword}}" data-field="keyword" bindinput="field" />
    <button bindtap="search" disabled="{{busy}}">查询运输</button>
    <view wx:for="{{rows}}" wx:key="id" class="card">
      <view class="title">{{item.plate_number}} · {{item.ship_date}}</view>
      <view class="hint">{{item.description}} · {{item.record_no}}
        {{item.phaseText}} · 照片 {{item.photo_count}} 张</view>
      <button wx:if="{{item.phase === 'awaiting_plate' && !item.invite_revoked_at}}" data-id="{{item.id}}" bindtap="select" disabled="{{busy}}">选择并发给司机</button>
    </view>
    <view wx:if="{{!rows.length && !busy}}" class="hint">没有符合条件的运输，可以清空搜索或新增本趟。</view>
    <button wx:if="{{page > 1}}" data-previous="true" bindtap="search" disabled="{{busy}}">上一页</button>
    <button wx:if="{{hasMore}}" data-next="true" bindtap="search" disabled="{{busy}}">下一页</button>
    <view wx:if="{{selected}}" class="card current-task">
      <view class="title">{{selected.plate}} · {{selected.date}}</view>
      <view class="hint">{{selected.description}}</view>
      <button class="primary" open-type="share" data-kind="driver" disabled="{{busy}}">发给司机</button>
      <view class="hint">在微信中选择联系人并确认发送；这里不会自动发消息。</view>
    </view>
    <button class="quiet" bindtap="logout" disabled="{{busy}}">退出管理员登录</button>
  </block>
</view>
