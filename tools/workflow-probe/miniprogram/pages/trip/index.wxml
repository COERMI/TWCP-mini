<template name="photos">
  <view wx:for="{{photos}}" wx:key="id" wx:for-item="photo" class="photo">
    <view class="photo-title">{{index + 1}}. {{photo.label}} · {{photo.statusText}}</view>
    <view class="actions">
      <button wx:if="{{photo.status === 'ready'}}" size="mini" data-id="{{photo.id}}" data-kind="watermarked" bindtap="preview" disabled="{{busy}}">查看水印图</button>
      <button wx:if="{{photo.original_bytes}}" size="mini" data-id="{{photo.id}}" data-kind="original" bindtap="preview" disabled="{{busy}}">查看原图</button>
      <button wx:if="{{photo.retryable && !done}}" size="mini" data-id="{{photo.id}}" bindtap="retryRemote" disabled="{{busy}}">重试归档</button>
      <button wx:if="{{!done}}" size="mini" class="danger-link" data-id="{{photo.id}}" bindtap="remove" disabled="{{busy}}">移除</button>
    </view>
  </view>
</template>
<view class="page">
  <view class="eyebrow">本趟运输 · 按提示拍照</view>
  <view wx:if="{{record}}" class="trip-head">
    <view class="plate">{{record.plate_number}}</view>
    <view>{{record.ship_date}} · {{record.description}}</view>
    <view class="muted">{{record.record_no}}</view>
  </view>
  <view class="heading">{{phaseText || '正在读取本趟运输…'}}</view>
  <view wx:if="{{error}}" class="alert">{{error}}</view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{busy && progress}}" class="card upload-status">
    <view>{{progress.stage}}{{progress.percent !== null ? ' ' + progress.percent + '%' : '…'}}</view>
    <progress wx:if="{{progress.percent !== null}}" percent="{{progress.percent}}" activeColor="#176047" />
  </view>

  <view wx:if="{{pending.length}}" class="card pending">
    <view class="title">本机待处理 {{pending.length}} 张</view>
    <view class="hint">照片保留在这台手机；恢复网络后点继续上传。退出后重新进入也能接续。</view>
    <view wx:for="{{pending}}" wx:key="id" class="photo">
      <view>{{item.event_name}} · {{item.label}}</view>
      <view class="hint">{{item.error || item.statusText}}</view>
      <button data-id="{{item.id}}" bindtap="retry" disabled="{{busy || done}}">继续上传 / 重试归档</button>
      <button class="quiet" data-id="{{item.id}}" bindtap="discard" disabled="{{busy || done}}">移除这张待处理照片</button>
    </view>
  </view>
  <block wx:if="{{state}}">
    <block wx:if="{{state.phase === 'preparing'}}">
      <view class="steps">
        <view wx:for="{{base}}" wx:key="type" class="step {{item.ready ? 'step-done' : currentStep.type === item.type ? 'step-active' : ''}}">
          <view class="step-dot">{{item.ready ? '✓' : item.index}}</view><view>{{item.label}}</view>
        </view>
      </view>
      <view wx:if="{{currentStep}}" class="card current-task">
        <view class="count">第 {{currentStep.index}} / 3 步</view>
        <view class="title">拍{{currentStep.label}}</view>
        <view class="hint">请将重要内容拍完整、拍清楚。保存成功后自动进入下一步。</view>
        <button class="primary" data-type="{{currentStep.type}}" data-event="{{currentStep.event_id}}" bindtap="shoot" disabled="{{busy}}">{{busy ? '正在保存，请稍候…' : '拍' + currentStep.label}}</button>
      </view>
      <view wx:else class="card"><view class="title">三项照片已拍齐</view>
        <button class="primary" bindtap="depart" disabled="{{busy || state.pending_count || pending.length}}">开始运输</button>
      </view>
    </block>
    <view wx:if="{{state.phase === 'transporting'}}" class="card current-task">
      <view class="title">每次开门、关门都拍照</view>
      <view class="hint">卸货、检查、特殊情况都一样；关门照片保存后，本次记录自动保存。</view>
      <button wx:if="{{!activeDoor}}" class="primary" bindtap="startDoor" disabled="{{busy}}">拍开门照片</button>
      <block wx:else>
        <view class="count">{{activeDoor.name}}</view>
        <button wx:if="{{!activeDoor.openReady}}" class="primary" data-event="{{activeDoor.id}}" data-type="DOOR_OPEN" bindtap="shoot" disabled="{{busy}}">拍开门照片</button>
        <button wx:elif="{{!activeDoor.closeReady}}" class="primary" data-event="{{activeDoor.id}}" data-type="DOOR_CLOSE" bindtap="shoot" disabled="{{busy}}">拍关门照片</button>
        <button wx:else class="primary" data-event="{{activeDoor.id}}" bindtap="finishDoor" disabled="{{busy || !activeDoor.canFinish}}">继续保存本次记录</button>
        <button wx:if="{{activeDoor.empty}}" class="quiet" data-event="{{activeDoor.id}}" bindtap="cancelDoor" disabled="{{busy}}">误点了，取消本次</button>
      </block>
    </view>
    <view class="actions secondary-nav">
      <button wx:if="{{!done}}" bindtap="toggleIssue">{{showIssue ? '收起问题反馈' : '问题反馈'}}</button>
      <button bindtap="toggleRecords">{{showRecords ? '收起照片记录' : '本趟照片记录 / 补拍'}}</button>
    </view>
    <block wx:if="{{showRecords}}">
      <view class="hint">补拍与移除均在对应记录中操作。最后一张必需照片须先补拍成功才能移除。</view>
      <view wx:for="{{base}}" wx:key="type" class="card">
        <view class="title">{{item.index}}. {{item.label}} · {{item.ready}} 张</view>
        <button wx:if="{{!done && item.ready}}" data-type="{{item.type}}" data-event="{{item.event_id}}" bindtap="shoot" disabled="{{busy}}">补拍{{item.label}}</button>
        <template is="photos" data="{{photos: item.photos, busy, done}}" />
      </view>
      <view wx:for="{{doors}}" wx:key="id" class="card">
        <view class="title">{{item.name}} · {{item.status === 'closed' ? '已保存' : '进行中'}}</view>
        <view wx:if="{{!done}}" class="actions">
          <button data-event="{{item.id}}" data-type="DOOR_OPEN" bindtap="shoot" disabled="{{busy}}">补拍开门</button>
          <button data-event="{{item.id}}" data-type="DOOR_CLOSE" bindtap="shoot" disabled="{{busy || !item.openReady}}">补拍关门</button>
        </view>
        <template is="photos" data="{{photos: item.photos, busy, done}}" />
      </view>
      <button class="quiet" bindtap="refresh" disabled="{{busy}}">刷新本趟状态</button>
    </block>
    <block wx:if="{{showIssue}}">
    <view class="section">额外问题，随时记录</view>
    <view wx:if="{{!done}}" class="card">
      <textarea maxlength="300" placeholder="例如：发现外包装破损，请说明情况（选填）" value="{{note}}" bindinput="noteInput" disabled="{{busy}}" />
      <button bindtap="saveIssue" disabled="{{busy}}">保存问题说明</button>
      <button data-type="ISSUE" bindtap="shoot" disabled="{{busy}}">拍一张问题照片</button>
    </view>
    <view wx:for="{{issues}}" wx:key="id" class="card">
      <view class="title">{{item.name}}</view>
      <view class="note">{{item.note || '可补充文字说明或照片'}}</view>
      <view wx:if="{{!done}}" class="actions">
        <button data-event="{{item.id}}" bindtap="editIssue" disabled="{{busy}}">补充说明</button>
        <button data-event="{{item.id}}" data-type="ISSUE" bindtap="shoot" disabled="{{busy}}">补拍照片</button>
      </view>
      <template is="photos" data="{{photos: item.photos, busy, done}}" />
    </view>

    </block>
    <view wx:if="{{state.phase !== 'preparing'}}" class="card finish">
      <view class="title">{{done ? '本趟已完成' : '最后一步：全部卸货完毕'}}</view>
      <view class="hint">{{done ? '记录已保留。若误点完成，可以填写原因纠正。' : '最后一次卸货也要拍开门、关门。所有照片归档后，再确认完成运输。'}}</view>
      <button wx:if="{{!done}}" class="primary" bindtap="complete" disabled="{{busy || !canComplete}}">全部卸货完毕，完成运输</button>
      <button wx:else bindtap="reopen" disabled="{{busy}}">误点完成？填写原因纠正</button>
    </view>
  </block>
</view>
